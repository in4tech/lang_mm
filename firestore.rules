rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /folders/{folderId} {
      allow read: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.setIds is list
        && request.resource.data.setIds.size() == 0;
      allow update: if request.auth != null
        && request.resource.data.ownerId == resource.data.ownerId
        && resource.data.ownerId == request.auth.uid
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['setIds'])
            && request.resource.data.setIds is list
            && request.resource.data.setIds.hasAll(resource.data.setIds)
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
            && request.resource.data.pinned is bool
          )
        );
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    match /sets/{setId} {
      allow read: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && (
          !request.resource.data.keys().hasAny(['folderId'])
          || (
            request.resource.data.folderId is string
            && request.resource.data.folderId.size() > 0
          )
        );
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['words'])
        && request.resource.data.words is list
        && resource.data.ownerId == request.auth.uid;
      allow delete: if false;
    }

    match /progress/{progressId} {
      allow read: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && progressId == request.auth.uid + '_' + request.resource.data.setId
        && (
          (
            request.resource.data.marks is map
            && request.resource.data.marks.values().hasOnly(['hard', 'familiar', 'easy'])
          )
          || request.resource.data.words is map
        );
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.setId == resource.data.setId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['marks', 'words', 'updatedAt'])
        && (
          !request.resource.data.keys().hasAny(['marks'])
          || (
            request.resource.data.marks is map
            && request.resource.data.marks.values().hasOnly(['hard', 'familiar', 'easy'])
          )
        )
        && (
          !request.resource.data.keys().hasAny(['words'])
          || request.resource.data.words is map
        );
      allow delete: if false;
    }

    match /agenda/{agendaId} {
      allow read: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && agendaId == request.auth.uid + '_' + request.resource.data.date
        && request.resource.data.words is list
        && request.resource.data.words.size() <= 8;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && agendaId == request.auth.uid + '_' + request.resource.data.date
        && resource.data.words.size() == 0
        && request.resource.data.words is list
        && request.resource.data.words.size() > 0
        && request.resource.data.words.size() <= 8
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['words']);
      allow delete: if false;
    }
  }
}
